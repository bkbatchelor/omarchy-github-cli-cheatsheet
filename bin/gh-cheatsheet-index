#!/bin/bash

# Build a categorized index of GitHub CLI commands from gh's own help output.
# Categories follow the gh manual's table of contents
# (https://cli.github.com/manual/): one section per built-in top-level
# command, alphabetical, with its subcommands underneath. User aliases and
# installed extensions aren't in the manual, so they are left out.
#
# Usage: gh-cheatsheet-index [--refresh] [--print]
#   --refresh  rebuild the cached index
#   --print    print a readable table instead of JSON

set -euo pipefail

PLUGIN_ID="io.github.bkbatchelor.omarchy-github-cli-cheatsheet"

# The shell's environment may not include user-level installs (mise, ~/.local/bin).
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 NO_COLOR=1

refresh=false
print=false

for arg in "$@"; do
  case "$arg" in
    --refresh) refresh=true ;;
    --print|-p) print=true ;;
    *) echo "Usage: gh-cheatsheet-index [--refresh] [--print]" >&2; exit 1 ;;
  esac
done

if ! command -v gh >/dev/null 2>&1; then
  echo '{"error":"gh not found"}'
  exit 0
fi

# Print "<SECTION>\t<name>\t<description>" for every entry under a *COMMANDS header.
parse_commands() {
  awk '
    /^[A-Z][A-Z ]*COMMANDS$/ { section = $0; next }
    /^[A-Z]/                 { section = ""; next }
    section != "" && match($0, /^  ([A-Za-z0-9][A-Za-z0-9_-]*):[ \t]+(.*)$/, m) {
      printf "%s\t%s\t%s\n", section, m[1], m[2]
    }
  '
}

is_manual_section() {
  case "$1" in
    "CORE COMMANDS"|"GITHUB ACTIONS COMMANDS"|"ADDITIONAL COMMANDS") return 0 ;;
    *) return 1 ;;
  esac
}

build_index() {
  local section name description subsection subname subdescription found

  while IFS=$'\t' read -r section name description; do
    is_manual_section "$section" || continue

    found=false

    while IFS=$'\t' read -r subsection subname subdescription; do
      found=true
      printf '%s\t%s\t%s\n' "$name" "gh $name $subname" "$subdescription"
    done < <(gh "$name" --help 2>/dev/null | parse_commands)

    if [[ $found == false ]]; then
      printf '%s\t%s\t%s\n' "$name" "gh $name" "$description"
    fi
  done < <(gh --help 2>/dev/null | parse_commands) | LC_ALL=C sort -t $'\t' -k1,1 -k2,2
}

# Print each category's name, a horizontal rule, then its commands.
print_index() {
  local width
  width=$(tput cols 2>/dev/null || echo 100)

  jq -r '
    (map(.command | length) | max) as $pad
    | .[] | [.category, .command, .description, ($pad | tostring)] | @tsv
  ' "$1" | awk -F '\t' -v width="$width" '
    BEGIN { rule = sprintf("%*s", width, ""); gsub(/ /, "-", rule) }
    $1 != current {
      if (current != "") print ""
      current = $1
      print current
      print rule
    }
    { printf "%-*s  %s\n", $4, $2, $3 }
  '
}

gh_version=$(gh --version 2>/dev/null | awk 'NR == 1 { print $3 }')
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/$PLUGIN_ID"
cache_file="$cache_dir/index-v2-${gh_version:-unknown}.json"

if [[ $refresh == true || ! -s $cache_file ]]; then
  mkdir -p "$cache_dir"
  tmp_file=$(mktemp "$cache_dir/.index.XXXXXX")
  trap 'rm -f "$tmp_file"' EXIT

  build_index | jq -R -s '
    split("\n")
    | map(select(length > 0) | split("\t") | {category: .[0], command: .[1], description: (.[2] // "")})
  ' >"$tmp_file"

  if [[ $(jq length "$tmp_file") -gt 0 ]]; then
    rm -f "$cache_dir"/index-*.json
    mv "$tmp_file" "$cache_file"
  else
    echo '{"error":"could not read gh help"}'
    exit 0
  fi
fi

if [[ $print == true ]]; then
  print_index "$cache_file"
else
  cat "$cache_file"
fi
